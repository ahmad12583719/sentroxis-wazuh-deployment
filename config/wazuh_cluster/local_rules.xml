<!-- Sentroxis Custom Rules for Log Normalization -->
<group name="sentroxis,normalization,">

  <!-- Custom rule for Windows endpoint telemetry -->
  <rule id="100001" level="3">
    <if_sid>60000</if_sid>
    <description>Sentroxis: Windows endpoint telemetry normalized.</description>
    <group>windows,telemetry,</group>
  </rule>

  <!-- Custom rule for Linux endpoint telemetry -->
  <rule id="100002" level="3">
    <if_sid>500</if_sid>
    <description>Sentroxis: Linux endpoint telemetry normalized.</description>
    <group>linux,telemetry,</group>
  </rule>

  <!-- Custom rule for macOS endpoint telemetry -->
  <rule id="100003" level="3">
    <if_sid>500</if_sid>
    <match>macOS</match>
    <description>Sentroxis: macOS endpoint telemetry normalized.</description>
    <group>macos,telemetry,</group>
  </rule>

  <!-- Custom rule for SNMP traps -->
  <rule id="100004" level="3">
    <match>SNMP-TRAP</match>
    <description>Sentroxis: SNMP Trap received and normalized.</description>
    <group>snmp,trap,</group>
  </rule>

</group>
